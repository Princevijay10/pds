# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Server ----
PORT=10000
NODE_ENV=development
# The deployed frontend origin — must match exactly, used for CORS.
CLIENT_URL=http://localhost:5173

# ---- Studio statistics ----
PDS_START_DATE=2023-09-01

# ---- Database (required) ----
MONGO_URI=mongodb://127.0.0.1:27017/prince_digital_studio
# Optional — only needed if your MONGO_URI doesn't already embed credentials.
# MONGO_USER=
# MONGO_PASS=

# ---- Auth (required) ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Admin seeding (required before running npm run seed) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- Cloudinary image storage (required for admin image uploads) ----
# Create these values in your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Web Push notifications ----
VAPID_SUBJECT=mailto:your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Outgoing email (optional — lead notifications are skipped if unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
