# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Server ----
PORT=10000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Studio statistics ----
PDS_START_DATE=2023-09-01

# ---- Database (required) ----
MONGO_URI=mongodb://127.0.0.1:27017/prince_digital_studio
# Optional — only needed if your MONGO_URI doesn't already embed credentials.
# MONGO_USER=
# MONGO_PASS=

# ---- Auth (required) ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Admin seeding (required before running npm run seed) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- Cloudinary image storage (required for admin image uploads + daily posters) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Daily Indian-occasion poster generation ----
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna

# ---- WhatsApp Cloud API ----
# Use a Meta WhatsApp Business Platform phone number and a system-user access token.
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated recipients in international format without +, e.g. 917597337190
WHATSAPP_RECIPIENTS=
# Approved template with IMAGE header + two BODY text variables: date, occasion
WHATSAPP_TEMPLATE_NAME=pds_daily_post
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Secret used only by the scheduled GitHub Action to call the automation endpoint.
DAILY_POST_AUTOMATION_SECRET=

# ---- Web Push notifications ----
VAPID_SUBJECT=mailto:your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Outgoing email (optional — lead notifications are skipped if unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
