# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Server ----
PORT=8080
NODE_ENV=development
# The deployed frontend origin — must match exactly, used for CORS.
CLIENT_URL=http://localhost:5173

# ---- Studio statistics ----
# Real studio start date used to calculate Years of Craft on the homepage.
# Format: YYYY-MM-DD. Leave unset until you provide the real date.
PDS_START_DATE=2025-09-01

# ---- Database (required) ----
MONGO_URI=mongodb://127.0.0.1:27017/prince_digital_studio
# Optional — only needed if your MONGO_URI doesn't already embed credentials.
# MONGO_USER=
# MONGO_PASS=

# ---- Auth (required) ----
# Use a long, random value — e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Admin seeding (required before running `npm run seed`) ----
# There is no default/fallback password — the seed script will refuse to run
# without these set, on purpose. Use a real, unique password (8+ chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ---- Web Push notifications ----
# Generate once with: npx web-push generate-vapid-keys
# Keep the private key secret and never commit the real .env.
VAPID_SUBJECT=mailto:your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Outgoing email (optional — lead notifications are skipped if unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where new-lead notification emails are sent. Defaults to SMTP_USER if unset.
NOTIFY_EMAIL=
